{
  "name": "exobuilder-gui",
  "apptitle": "ExoBuilder",
  "version": "1.0.0",
  "description": "A simple graphical interface for exobuilder, made with electron js.",
  "main": "index.js",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-dmg": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.0",
    "@electron-forge/plugin-fuses": "^7.8.0",
    "@electron-forge/publisher-github": "^7.8.0",
    "@electron/fuses": "^1.8.0",
    "electron": "^35.2.0"
  },
  "scripts": {
    "test-linux": "APP_DEV=true electron .",
    "test-macos": "APP_DEV=true electron .",
    "test-windows": "set APP_DEV=true && electron .",
    "test-prod": "electron .",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "env-cmd electron-forge publish"
  },
  "build": {
    "appid": "com.xcenter.exobuildergui",
    "productname": "ExoNuilder",
    "extraResources": [
      {
        "from": "./libs/",
        "to": "libs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "exbi",
        "name": "ExoBuilder Info File",
        "role": "Editor",
        "perMachine": true
      }
    ],
    "mac": {
      "icon": "resources/libs/Ex0sArc4d3P1C.icns"
    },
    "win": {
      "icon": "resources/libs/Ex0sArc4d3P1C.ico"
    },
    "linux": {
      "icon": "resources/libs/Ex0sArc4d3P1C.png"
    }
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": true,
        "extraResource": [
          "./libs"
        ],
        "icon": "./libs/Ex0sArc4d3P1C"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip"
        },
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "exobuilder-gui"
          }
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "background": "./libs/Ex0sArc4d3P1C.png",
            "format": "ULFO"
          }
        }
      ],
      "publishers": [
        {
          "name": "@electron-forge/publisher-github",
          "config": {
            "repository": {
              "owner": "Xarber",
              "name": "exobuilder-gui"
            },
            "prerelease": false,
            "draft": true
          }
        }
      ]
    }
  },
  "author": "Xarber",
  "license": "ISC",
  "dependencies": {
    "deasync": "^0.1.30",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.6.2",
    "env-cmd": "^10.1.0",
    "formidable": "^3.5.3",
    "hi-base32": "^0.5.1",
    "ip": "^2.0.1",
    "lookpath": "^1.2.3",
    "otpauth": "^9.4.0",
    "public-ip": "^7.0.1",
    "qrcode": "^1.5.4",
    "request": "^2.88.2",
    "telegram": "^2.26.22",
    "webtorrent": "^2.6.3"
  }
}
